---
import '../styles/global.css';
import ThemeScript from '../components/ui/ThemeScript.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import SignOutButton from '../components/admin/SignOutButton.astro';

interface Props {
  title: string;
  /** Se pasa explícitamente en lugar de leer Astro.locals dentro del layout:
   *  así la página protegida es responsable de garantizar que existe. */
  user: { id: string; name: string; email: string };
  /** Texto de apoyo bajo el título. */
  description?: string;
}

const { title, user, description } = Astro.props;
const { pathname } = Astro.url;

/**
 * Enlace a la landing pública.
 *
 * Se toma de `PUBLIC_SITE_URL` en lugar de escribir el dominio a mano: ya es el
 * valor canónico de "dónde vive este sitio" (lo usan el canonical, OpenGraph y
 * el sitemap), así que no puede quedar desincronizado. En local apunta a la
 * landing local, que es lo útil mientras se desarrolla; en producción, al
 * dominio real.
 *
 * Para abrir SIEMPRE la landing de producción aunque se trabaje en local,
 * sustituir por la URL literal.
 */
const landingUrl = Astro.site?.href ?? '/';

const navItems = [
  {
    href: '/admin',
    label: 'Contenido',
    // `/admin/contenido/...` también marca "Contenido" como activo.
    match: (p: string) => p === '/admin' || p.startsWith('/admin/contenido'),
    icon: 'M4 6h16M4 12h16M4 18h10',
  },
  {
    href: '/admin/formulario',
    label: 'Formulario',
    match: (p: string) => p.startsWith('/admin/formulario'),
    icon: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z M14 2v6h6 M9 13h6 M9 17h3',
  },
  {
    href: '/admin/secciones',
    label: 'Secciones',
    match: (p: string) => p.startsWith('/admin/secciones'),
    icon: 'M3 5h18M3 12h18M3 19h18',
  },
  {
    href: '/admin/usuarios',
    label: 'Usuarios',
    match: (p: string) => p.startsWith('/admin/usuarios'),
    icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  },
];

function initials(name: string): string {
  return name.trim().split(/\s+/).slice(0, 2).map((p) => p[0]?.toUpperCase() ?? '').join('');
}
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>{title} | Panel Hospital Cristal</title>
    {/* El dashboard nunca se indexa. robots.txt evita el rastreo; esto evita la
        indexación si alguien enlaza una URL desde fuera. */}
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0d9488" />
  </head>

  <body class="min-h-dvh bg-bg text-fg">
    <a
      href="#panel"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-primary-fg"
    >
      Saltar al contenido
    </a>

    <div class="flex min-h-dvh flex-col lg:flex-row">
      <!-- Sidebar -->
      <aside class="border-b border-border bg-surface lg:w-60 lg:shrink-0 lg:border-b-0 lg:border-r">
        <div class="flex items-center gap-2.5 px-4 py-4 lg:px-5">
          <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary text-primary-fg" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true">
              <path d="M9 2h6M10 2v6.5L5.8 16.4A3 3 0 0 0 8.4 21h7.2a3 3 0 0 0 2.6-4.6L14 8.5V2" />
              <path d="M7.5 15h9" />
            </svg>
          </span>
          <span class="text-sm font-semibold leading-tight">
            Panel
            <span class="block text-xs font-normal text-fg-muted">Hospital Cristal</span>
          </span>
        </div>

        <nav aria-label="Secciones del panel" class="px-2 pb-3 lg:px-3">
          <ul class="flex gap-1 lg:flex-col">
            {navItems.map((item) => {
              const active = item.match(pathname);
              return (
                <li class="flex-1 lg:flex-none">
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
                      active
                        ? 'bg-primary/10 text-primary'
                        : 'text-fg-muted hover:bg-surface-muted hover:text-fg',
                    ]}
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0" aria-hidden="true">
                      <path d={item.icon} />
                    </svg>
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <div class="hidden border-t border-border px-5 py-4 lg:block">
          <div class="flex items-center gap-2.5">
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-primary text-xs font-bold text-primary-fg" aria-hidden="true">
              {initials(user.name)}
            </span>
            <span class="min-w-0 text-xs leading-tight">
              <span class="block truncate font-semibold text-fg">{user.name}</span>
              <span class="block truncate text-fg-muted">{user.email}</span>
            </span>
          </div>
        </div>
      </aside>

      <!-- Contenido -->
      <div class="flex min-w-0 flex-1 flex-col">
        <header class="flex items-center gap-3 border-b border-border bg-surface px-4 py-3 sm:px-6">
          <div class="min-w-0 flex-1">
            <h1 class="truncate text-lg font-semibold">{title}</h1>
            {description && <p class="truncate text-sm text-fg-muted">{description}</p>}
          </div>
          <slot name="actions" />

          <!--
            Enlace a la landing, disponible en todas las pantallas del panel
            porque vive en el layout. Se abre en otra pestaña para no perder lo
            que el editor esté escribiendo: `SectionEditor` avisa al salir con
            cambios sin guardar, y navegar en la misma pestaña dispararía ese
            aviso cada vez.
          -->
          <a
            href={landingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-3 py-2 text-sm font-medium text-fg-muted transition-colors hover:bg-surface-muted hover:text-fg"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0" aria-hidden="true">
              <path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            </svg>
            <span class="hidden sm:inline">Ir a la Landing</span>
            <span class="sr-only sm:hidden">Ir a la Landing</span>
            <!-- Los lectores de pantalla deben saber que sale de la pestaña. -->
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>

          <ThemeToggle />
          <SignOutButton />
        </header>

        <main id="panel" class="flex-1 px-4 py-6 sm:px-6 sm:py-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
