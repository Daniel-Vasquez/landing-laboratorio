---
import type { LandingContent } from '../../lib/content/schemas.ts';
import type { LandingImages } from '../../lib/images/repository.ts';
import { getSlot } from '../../lib/images/slots.ts';
import Button from '../ui/Button.astro';
import AsideFigure from './AsideFigure.astro';

interface Props {
  data: LandingContent['hero'];
  images: LandingImages;
  /** Fondo alterno; lo decide `index.astro` por posición renderizada. */
  tone?: 'base' | 'muted';
}
const { data, images, tone = 'base' } = Astro.props;
const slot = getSlot('hero')!;
---
<section id="inicio" class:list={[tone === 'muted' ? 'border-y border-border bg-surface-muted' : 'bg-bg']}>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 lg:py-28">
    <!--
      `lg:items-center` y no `items-start`: con el texto más alto que la imagen,
      alinear arriba deja la imagen flotando sola contra el borde superior.
      En móvil es una sola columna y el orden del DOM manda (ver el `order` de
      la figura más abajo).
    -->
    <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-14">
      <div class="flex flex-col">
        <h1 class="text-4xl font-bold leading-[1.1] sm:text-5xl lg:text-6xl">
          {data.headline}
        </h1>

        <p class="mt-6 max-w-2xl text-lg text-fg-muted sm:text-xl">{data.subheadline}</p>

        <ul class="mt-8 grid gap-3 sm:grid-cols-3 lg:grid-cols-1 lg:gap-2.5">
          {data.bullets.map((bullet) => (
            <li class="flex items-start gap-2.5 rounded-xl border border-border bg-surface p-4 text-sm font-medium lg:border-0 lg:bg-transparent lg:p-0">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 size-4 shrink-0 text-primary" aria-hidden="true">
                <path d="m20 6L9 17l-5-5" />
              </svg>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>

        <p class="mt-8 flex items-start gap-2 text-sm text-fg-muted">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 size-4 shrink-0 text-accent" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span>{data.address}</span>
        </p>

        <div class="mt-8">
          <Button href={data.cta.href} mode={data.cta.mode} servicio="hero" size="lg">{data.cta.label}</Button>
        </div>
      </div>

      <!--
        `order-last` en móvil: la imagen va DESPUÉS del CTA. Interponerla entre
        el texto y el botón empujaría la conversión por debajo del pliegue.
        En escritorio vuelve a su columna derecha.
      -->
      <div class="order-last lg:order-none">
        <AsideFigure imageSlot={slot} image={images[slot.id]} priority />
      </div>
    </div>
  </div>
</section>
