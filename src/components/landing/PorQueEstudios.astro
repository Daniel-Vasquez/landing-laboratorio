---
import type { LandingContent } from '../../lib/content/schemas.ts';
import type { LandingImages } from '../../lib/images/repository.ts';
import { getSlot } from '../../lib/images/slots.ts';
import Section from './Section.astro';
import Button from '../ui/Button.astro';
import AsideFigure from './AsideFigure.astro';

interface Props {
  data: LandingContent['por_que_estudios'];
  images: LandingImages;
  /**
   * Fondo alterno. Lo decide `index.astro` por POSICIÓN RENDERIZADA, no el
   * componente: al reordenar u ocultar secciones, un tono fijo aquí dejaría
   * dos bandas `muted` contiguas.
   */
  tone?: 'base' | 'muted';
}
const { data, images, tone = 'base' } = Astro.props;
const slot = getSlot('deteccion-oportuna')!;
---
<Section id="por-que" tone={tone} eyebrow="Detección oportuna" title={data.eyebrow}>
  <div class="mt-5 grid items-start gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-14">
    <p class="text-fg-muted">{data.intro}</p>
    <!-- En móvil la imagen queda tras el texto introductorio, antes de los datos. -->
    <AsideFigure imageSlot={slot} image={images[slot.id]} />
  </div>

  <p class="mt-10 text-sm font-semibold uppercase tracking-wide text-fg">{data.datosLabel}</p>

  <ul class="mt-5 grid gap-4 lg:grid-cols-3">
    {data.datos.map((dato) => (
      <li class="rounded-xl border-l-4 border-l-accent border-y border-r border-border bg-surface p-5">
        <p class="text-sm leading-relaxed text-fg-muted">{dato}</p>
      </li>
    ))}
  </ul>

  <p class="mt-10 max-w-3xl text-lg font-medium">{data.cierre}</p>

  <div class="mt-8">
    <Button href={data.cta.href} mode={data.cta.mode} servicio="por-que" size="lg">{data.cta.label}</Button>
  </div>
</Section>
