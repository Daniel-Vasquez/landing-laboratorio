---
import type { LandingContent } from '../../lib/content/schemas.ts';
import Section from './Section.astro';
import Button from '../ui/Button.astro';
import Icon from './Icon.astro';

interface Props {
  data: LandingContent['por_que_hospital'];
}
const { data } = Astro.props;

/**
 * Iconos por defecto mientras un beneficio no tenga `icon` configurado.
 * Sustituyen al array de `path` SVG sueltos que vivía aquí: ahora el icono es
 * contenido editable, no un fragmento de geometría en el componente.
 */
const fallbackIcons = [
  'clock',
  'shield-check',
  'badge-dollar-sign',
  'list-checks',
  'sparkles',
  'hospital',
];
---
<Section id="beneficios" eyebrow="Ventajas" title={data.eyebrow}>
  <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {data.beneficios.map((beneficio, i) => (
      <li class="rounded-xl border border-border bg-surface p-6">
        <!-- El fondo de la pastilla lo define el dato (`icon.background`), no una
             clase: si se pusiera aquí, el color elegido en el panel quedaría
             tapado por el de Tailwind. -->
        <Icon icon={beneficio.icon} fallbackName={fallbackIcons[i]} size={22} />
        <h3 class="mt-4 text-lg font-semibold">{beneficio.titulo}</h3>
        <p class="mt-2 text-sm leading-relaxed text-fg-muted">{beneficio.descripcion}</p>
      </li>
    ))}
  </ul>

  <div class="mt-10">
    <Button href={data.cta.href} size="lg">{data.cta.label}</Button>
  </div>
</Section>
