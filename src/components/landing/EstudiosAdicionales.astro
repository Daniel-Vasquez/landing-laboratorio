---
import type { LandingContent } from '../../lib/content/schemas.ts';
import Section from './Section.astro';
import Button from '../ui/Button.astro';
import Icon from './Icon.astro';

interface Props {
  data: LandingContent['estudios_adicionales'];
  /**
   * Fondo alterno. Lo decide `index.astro` por POSICIÓN RENDERIZADA, no el
   * componente: al reordenar u ocultar secciones, un tono fijo aquí dejaría
   * dos bandas `muted` contiguas.
   */
  tone?: 'base' | 'muted';
}
const { data, tone = 'base' } = Astro.props;
---
<Section id="adicionales" tone={tone} eyebrow={data.eyebrow} title="Cobertura para cualquier necesidad médica">
  <p class="mt-5 max-w-3xl text-fg-muted">{data.intro}</p>

  <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {data.items.map((item) => (
      <li class="flex items-start gap-3 rounded-xl border border-border bg-surface p-5">
        <span class="mt-0.5 text-primary">
          <Icon icon={item.icon} fallbackName="clipboard-list" size={20} />
        </span>
        <div>
          <h3 class="font-semibold">{item.titulo}</h3>
          <p class="mt-1 text-sm text-fg-muted">{item.detalle}</p>
        </div>
      </li>
    ))}
  </ul>

  <div class="mt-10">
    <Button href={data.cta.href} mode={data.cta.mode} servicio="adicionales" size="lg">{data.cta.label}</Button>
  </div>
</Section>
