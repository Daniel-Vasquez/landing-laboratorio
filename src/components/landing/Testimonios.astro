---
import type { LandingContent } from '../../lib/content/schemas.ts';
import Section from './Section.astro';
import Button from '../ui/Button.astro';

interface Props {
  data: LandingContent['testimonios'];
  /**
   * Fondo alterno. Lo decide `index.astro` por POSICIÓN RENDERIZADA, no el
   * componente: al reordenar u ocultar secciones, un tono fijo aquí dejaría
   * dos bandas `muted` contiguas.
   */
  tone?: 'base' | 'muted';
}
const { data, tone = 'base' } = Astro.props;

function initials(name: string): string {
  return name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
}
---
<Section id="testimonios" tone={tone} eyebrow={data.eyebrow} title="Pacientes que ya nos eligieron">
  <ul class="mt-10 grid gap-4 lg:grid-cols-3">
    {data.items.map((item) => (
      <li class="flex flex-col rounded-xl border border-border bg-surface p-6">
        <svg viewBox="0 0 24 24" fill="currentColor" class="size-7 text-primary/30" aria-hidden="true">
          <path d="M9.5 5C6.5 5 4 7.5 4 10.5S6.5 16 9.5 16c.3 0 .5 0 .8-.1-.6 1.7-2 3-3.8 3.4a.6.6 0 0 0 .2 1.2C11 20 14 16.4 14 11.4 14 7.8 12 5 9.5 5Z" />
        </svg>
        <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-fg-muted">
          {item.quote}
        </blockquote>
        <figcaption class="mt-5 flex items-center gap-3 border-t border-border pt-4">
          <span
            class="grid size-9 shrink-0 place-items-center rounded-full bg-primary text-xs font-bold text-primary-fg"
            aria-hidden="true"
          >
            {initials(item.autor)}
          </span>
          <cite class="text-sm font-semibold not-italic text-fg">{item.autor}</cite>
        </figcaption>
      </li>
    ))}
  </ul>

  <div class="mt-10">
    <Button href={data.cta.href} mode={data.cta.mode} servicio="testimonios" size="lg">{data.cta.label}</Button>
  </div>
</Section>
