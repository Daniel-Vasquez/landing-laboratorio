---
import { QUESTIONS } from '../../lib/leads/questions.ts';
import type { ResolvedLeadForm } from '../../lib/leads/repository.ts';

interface Props {
  config: ResolvedLeadForm;
  privacidadHref: string;
}
const { config, privacidadHref } = Astro.props;

const pasos = [1, 2, 3] as const;
const porPaso = (paso: number) => QUESTIONS.filter((q) => q.step === paso);

/**
 * El MARKUP se renderiza en build; solo el COMPORTAMIENTO llega bajo demanda.
 *
 * Así el formulario existe en el HTML —sin coste de JavaScript inicial— y queda
 * operativo en cuanto el módulo se descarga, al primer clic en un CTA.
 */
---
<dialog
  id="lead-form"
  aria-labelledby="lead-form-title"
  class="m-auto max-h-[90vh] w-[min(38rem,94vw)] overflow-hidden rounded-2xl border border-border bg-surface p-0 text-fg backdrop:bg-black/50"
>
  <form id="lead-form-el" class="flex max-h-[90vh] flex-col" novalidate>
    <div class="flex shrink-0 items-start justify-between gap-3 border-b border-border p-5">
      <div>
        <h2 id="lead-form-title" class="text-lg font-semibold">{config.textos.titulo}</h2>
        <p class="mt-1 text-sm text-fg-muted">{config.textos.intro}</p>
      </div>
      <button
        type="button"
        data-lead-close
        aria-label="Cerrar"
        class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-border text-fg-muted transition-colors hover:bg-surface-muted hover:text-fg"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-4" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto p-5" data-lead-body>
      <!--
        Pregunta PERSISTENTE: vive fuera del contenedor de pasos, así que cambiar
        de paso no la remonta ni pierde la selección.
      -->
      <fieldset class="rounded-xl border border-border bg-bg p-4">
        <legend class="px-1 text-sm font-medium text-fg">{config.preguntas.contacto.label}</legend>
        <div class="mt-2 grid gap-2 sm:grid-cols-3">
          {config.preguntas.contacto.options.map((option, i) => (
            <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-border-strong bg-surface px-3 py-2.5 text-sm has-[:checked]:border-primary has-[:checked]:bg-primary/10">
              <input
                type="radio"
                name="medio"
                value={option.value}
                checked={i === 0}
                class="size-4 accent-[var(--color-primary)]"
              />
              <span>{option.label}</span>
              {option.featured && (
                <span class="ml-auto rounded bg-primary/15 px-1.5 py-0.5 text-xs font-medium text-primary">
                  Recomendado
                </span>
              )}
            </label>
          ))}
        </div>
      </fieldset>

      <p class="mt-5 text-xs font-semibold uppercase tracking-wide text-fg-muted" data-lead-progress>
        Paso 1 de 3
      </p>

      {pasos.map((paso) => (
        <section data-lead-step={paso} hidden={paso !== 1} class="mt-2 space-y-5">
          <h3 class="sr-only" tabindex="-1" data-lead-step-title>Paso {paso} de 3</h3>

          {porPaso(paso).map((question) => (
            <fieldset>
              <legend class="text-sm font-medium text-fg">
                {config.preguntas[question.id].label}
              </legend>
              <div
                class:list={[
                  'mt-2 gap-2',
                  question.layout === 'inline' ? 'grid sm:grid-cols-2' : 'grid',
                ]}
              >
                {config.preguntas[question.id].options.map((option) => (
                  <label class="flex cursor-pointer items-start gap-2.5 rounded-lg border border-border-strong bg-bg px-3 py-2.5 text-sm has-[:checked]:border-primary has-[:checked]:bg-primary/10">
                    <input
                      type="radio"
                      name={question.id}
                      value={option.value}
                      class="mt-0.5 size-4 shrink-0 accent-[var(--color-primary)]"
                    />
                    <span>{option.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}

          {paso === 3 && (
            <div class="space-y-4">
              <div>
                <label for="lead-nombre" class="mb-1.5 block text-sm font-medium text-fg">
                  Nombre completo
                </label>
                <input
                  id="lead-nombre"
                  name="nombre"
                  type="text"
                  autocomplete="name"
                  placeholder="Ej. Ana García"
                  class="w-full rounded-lg border border-border-strong bg-bg px-3.5 py-2.5 text-sm text-fg"
                />
              </div>

              <!-- Campo dinámico: se muestra uno u otro según la preferencia. -->
              <div data-lead-field="telefono">
                <label for="lead-telefono" class="mb-1.5 block text-sm font-medium text-fg">
                  Teléfono o WhatsApp
                </label>
                <input
                  id="lead-telefono"
                  name="telefono"
                  type="tel"
                  inputmode="numeric"
                  autocomplete="tel-national"
                  placeholder="10 dígitos"
                  class="w-full rounded-lg border border-border-strong bg-bg px-3.5 py-2.5 text-sm text-fg"
                />
              </div>

              <div data-lead-field="correo" hidden>
                <label for="lead-correo" class="mb-1.5 block text-sm font-medium text-fg">
                  Correo electrónico
                </label>
                <input
                  id="lead-correo"
                  name="correo"
                  type="email"
                  autocomplete="email"
                  placeholder="tucorreo@ejemplo.com"
                  class="w-full rounded-lg border border-border-strong bg-bg px-3.5 py-2.5 text-sm text-fg"
                />
              </div>

              <label class="flex cursor-pointer items-start gap-2.5 text-sm text-fg-muted">
                <input
                  type="checkbox"
                  name="consentimiento"
                  class="mt-0.5 size-4 shrink-0 accent-[var(--color-primary)]"
                />
                <span>
                  {config.textos.consentimiento}{' '}
                  <a
                    href={privacidadHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-accent underline-offset-4 hover:underline"
                  >
                    Ver aviso de privacidad
                    <span class="sr-only"> (se abre en una pestaña nueva)</span>
                  </a>
                </span>
              </label>
            </div>
          )}
        </section>
      ))}

      <!-- Trampa para bots. `aria-hidden` y fuera del flujo, no `display:none`
           a secas: algunos bots ignoran los campos ocultos por CSS. -->
      <div class="absolute left-[-9999px] top-auto size-px overflow-hidden" aria-hidden="true">
        <label for="lead-empresa">Empresa</label>
        <input id="lead-empresa" name="empresa" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <p role="alert" data-lead-error hidden class="mt-4 rounded-lg border border-red-500/40 bg-red-500/10 px-3.5 py-2.5 text-sm text-red-700 dark:text-red-300"></p>

      <div data-lead-success hidden class="mt-4 rounded-lg border border-emerald-600/40 bg-emerald-600/10 px-4 py-4 text-sm text-emerald-900 dark:text-emerald-200">
        <p class="font-semibold" data-lead-success-text>{config.textos.exito}</p>
        <p class="mt-2" data-lead-success-extra hidden></p>
      </div>
    </div>

    <div class="flex shrink-0 items-center gap-3 border-t border-border p-5">
      <button
        type="button"
        data-lead-prev
        hidden
        class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium text-fg transition-colors hover:bg-surface-muted"
      >
        Atrás
      </button>
      <span class="flex-1"></span>
      <button
        type="button"
        data-lead-next
        class="rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-fg transition-colors hover:bg-primary-hover"
      >
        Siguiente
      </button>
      <button
        type="submit"
        data-lead-submit
        hidden
        class="rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-fg transition-colors hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60"
      >
        Enviar WhatsApp
      </button>
    </div>
  </form>
</dialog>
