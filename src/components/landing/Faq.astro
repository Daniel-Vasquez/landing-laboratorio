---
import type { LandingContent } from '../../lib/content/schemas.ts';
import type { LandingImages } from '../../lib/images/repository.ts';
import { getSlot } from '../../lib/images/slots.ts';
import { cloudinaryUrl } from '../../lib/images/url.ts';
import Button from '../ui/Button.astro';

interface Props {
  data: LandingContent['faq'];
  images: LandingImages;
}
const { data, images } = Astro.props;

const slot = getSlot('faq-fondo')!;
const background = images[slot.id];

/**
 * Fondo desenfocado con `e_blur:400`, en la TRANSFORMACIÓN de entrega y no en CSS.
 *
 * Un `filter: blur()` de CSS se aplica en el cliente sobre la imagen completa y
 * cuesta pintado en cada scroll. Cloudinary lo hornea en el archivo servido, que
 * además pesa mucho menos: el desenfoque elimina detalle que el compresor ya no
 * tiene que codificar.
 */
const backgroundUrl = background ? cloudinaryUrl(background, 1600, 'e_blur:400') : null;
const backgroundHeight = Math.round((slot.displayWidth * 9) / 16);

/**
 * El acordeón usa <details>/<summary> nativos: accesible por defecto (rol,
 * aria-expanded y teclado los da el navegador) y 0 KB de JS.
 */
---
<!--
  Sección con imagen de fondo. El texto NO se apoya sobre la fotografía:

  1. La imagen va detrás de todo, con `aria-hidden`: es decorativa.
  2. Encima lleva un SCRIM OPACO al 92 %, no una opacidad sobre la imagen. Con
     ese valor el color del token domina y se conservan los ratios medidos en la
     Tanda 9 — texto sobre foto los invalidaría, porque el contraste pasaría a
     depender de cada píxel.
  3. Las tarjetas del acordeón mantienen `bg-surface` OPACO. El fondo se percibe
     en los márgenes de la sección, nunca debajo del texto.
-->
<section id="faq" class="relative isolate scroll-mt-16 border-y border-border">
  {
    backgroundUrl && (
      <img
        src={backgroundUrl}
        alt=""
        aria-hidden="true"
        width={slot.displayWidth}
        height={backgroundHeight}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 -z-10 size-full object-cover"
      />
    )
  }
  <div class="absolute inset-0 -z-10 bg-surface-muted/92" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">{data.eyebrow}</p>
    <h2 class="mt-3 max-w-3xl text-3xl font-bold sm:text-4xl">Preguntas frecuentes</h2>

    <div
      class="mt-10 max-w-3xl divide-y divide-border overflow-hidden rounded-xl border border-border bg-surface"
    >
      {
        data.items.map((item) => (
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 text-left font-semibold marker:content-none [&::-webkit-details-marker]:hidden">
              <span>{item.pregunta}</span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-5 shrink-0 text-accent transition-transform duration-200 group-open:rotate-180"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <p class="px-5 pb-5 text-sm leading-relaxed text-fg-muted">{item.respuesta}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-10">
      <Button href={data.cta.href} size="lg">{data.cta.label}</Button>
    </div>
  </div>
</section>
