---
/**
 * Envoltorio de sección. Centraliza el ritmo vertical, el ancho del contenedor
 * y la alternancia de fondos, para que las 9 secciones no repitan las mismas
 * clases (y no se desincronicen al ajustar el espaciado).
 */
interface Props {
  id: string;
  /** `muted` pinta la banda alterna. */
  tone?: 'base' | 'muted';
  eyebrow?: string;
  title?: string;
  /** Renderiza el título como <h1> en lugar de <h2>. Solo el Hero lo usa. */
  headingLevel?: 'h1' | 'h2';
  class?: string;
}

const {
  id,
  tone = 'base',
  eyebrow,
  title,
  headingLevel = 'h2',
  class: extra = '',
} = Astro.props;

const Heading = headingLevel;
---
<section
  id={id}
  class:list={[
    'scroll-mt-16',
    tone === 'muted' ? 'border-y border-border bg-surface-muted' : 'bg-bg',
    extra,
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-24">
    {eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-wide text-accent">{eyebrow}</p>
    )}
    {title && (
      <Heading class="mt-3 max-w-3xl text-3xl font-bold sm:text-4xl">{title}</Heading>
    )}
    <slot />
  </div>
</section>
