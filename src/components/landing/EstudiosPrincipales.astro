---
import type { LandingContent } from '../../lib/content/schemas.ts';
import type { LandingImages } from '../../lib/images/repository.ts';
import { cardGroupFor, cardSlot, cardSlotKey } from '../../lib/images/cards.ts';
import Section from './Section.astro';
import Button from '../ui/Button.astro';
import SlotImage from './SlotImage.astro';

interface Props {
  data: LandingContent['estudios_principales'];
  images: LandingImages;
}
const { data, images } = Astro.props;
const group = cardGroupFor('estudios_principales')!;
---
<Section id="estudios" tone="muted" eyebrow={data.eyebrow} title="Los estudios más solicitados">
  <p class="mt-5 max-w-3xl text-fg-muted">{data.intro}</p>

  <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {data.estudios.map((estudio) => {
      /*
       * El emparejamiento es por `imageKey`, un id inmutable que el servidor
       * asigna a cada tarjeta. Ni renombrarla ni reordenarla afecta a su imagen.
       * Una tarjeta recién creada aún no tiene imagen: se renderiza sin el
       * bloque, no con un hueco vacío.
       */
      const image = estudio.imageKey ? images[cardSlotKey(group, estudio.imageKey)] : undefined;
      const slot = estudio.imageKey
        ? cardSlot(group, estudio.imageKey, estudio.nombre, image?.publicId)
        : undefined;
      return (
        <li class="flex flex-col overflow-hidden rounded-xl border border-border bg-surface">
          {slot && image && (
            <div class="bg-surface-muted" style={`aspect-ratio: ${slot.aspect}`}>
              <SlotImage
                imageSlot={slot}
                image={image}
                sizes="(min-width: 1024px) 420px, (min-width: 640px) 50vw, 100vw"
              />
            </div>
          )}
          <div class="flex flex-1 flex-col p-6">
            <h3 class="text-lg font-semibold">{estudio.nombre}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{estudio.descripcion}</p>
          </div>
        </li>
      );
    })}
  </ul>

  <div class="mt-10">
    <Button href={data.cta.href} size="lg">{data.cta.label}</Button>
  </div>
</Section>
