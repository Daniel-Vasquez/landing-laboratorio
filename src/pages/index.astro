---
/**
 * Landing page — 100% estática (SSG).
 *
 * `getLandingContent()` se ejecuta UNA vez, en build time. El HTML resultante
 * es inmutable: en producción esta página no hace ninguna query a MongoDB.
 * Para que un cambio de contenido se refleje hace falta un redeploy, que el
 * dashboard dispara vía Deploy Hook de Vercel (Tanda 7).
 */
import LandingLayout from '../layouts/LandingLayout.astro';
import Hero from '../components/landing/Hero.astro';
import EstudiosPrincipales from '../components/landing/EstudiosPrincipales.astro';
import PorQueEstudios from '../components/landing/PorQueEstudios.astro';
import EstudiosAdicionales from '../components/landing/EstudiosAdicionales.astro';
import PorQueHospital from '../components/landing/PorQueHospital.astro';
import Testimonios from '../components/landing/Testimonios.astro';
import Videos from '../components/landing/Videos.astro';
import Faq from '../components/landing/Faq.astro';
import CtaFinal from '../components/landing/CtaFinal.astro';
import { getLandingContent } from '../lib/content/repository.ts';
import { getLandingImages } from '../lib/images/repository.ts';
import { buildJsonLd } from '../lib/seo.ts';
import { getSectionLayout } from '../lib/sections/repository.ts';
import { buildNavItems } from '../lib/nav.ts';

export const prerender = true;

// Tres queries en total: contenido, imágenes y configuración de secciones.
const [content, images, layout] = await Promise.all([
  getLandingContent(),
  getLandingImages(),
  getSectionLayout(),
]);

/**
 * Mapa clave -> componente.
 *
 * Los imports siguen siendo ESTÁTICOS: Astro no puede hacer tree-shaking de un
 * import dinámico por nombre, y el registro de `sections/registry.ts` garantiza
 * que toda clave renderizable tiene entrada aquí.
 */
const COMPONENTS = {
  hero: Hero,
  estudios_principales: EstudiosPrincipales,
  por_que_estudios: PorQueEstudios,
  estudios_adicionales: EstudiosAdicionales,
  por_que_hospital: PorQueHospital,
  testimonios: Testimonios,
  videos: Videos,
  faq: Faq,
  cta_final: CtaFinal,
} as const;

const visibleSections = layout.filter((section) => section.visible);
const menu = buildNavItems(layout);
const siteUrl = (Astro.site ?? new URL('http://localhost:4321')).href;
const jsonLd = buildJsonLd(content, siteUrl);
---
<LandingLayout
  seo={content.seo}
  avisos={content.avisos}
  address={content.hero.address}
  jsonLd={jsonLd}
  menu={menu}
>
  {
    visibleSections.map((section, index) => {
      /*
       * Cast acotado a este único punto.
       *
       * TypeScript no puede emparejar cada clave con su tipo de datos en un
       * mapa dinámico: ve la UNIÓN de los nueve `data` frente a la
       * INTERSECCIÓN de las nueve firmas de props, y las rechaza.
       *
       * Lo que garantiza la corrección no es el tipo aquí, sino que
       * `sections/registry.ts` y `COMPONENTS` se indexan con las mismas claves:
       * `RenderableKey` se deriva del registro, así que añadir una sección sin
       * su componente —u olvidar quitarla— sí falla en compilación, en la
       * declaración de `COMPONENTS`.
       */
      const Component = COMPONENTS[section.key] as unknown as (props: Record<string, unknown>) => unknown;
      /*
       * La alternancia de fondos se calcula por POSICIÓN RENDERIZADA, no dentro
       * del componente. Con el orden fijo daba igual; al reordenar u ocultar,
       * dos secciones `muted` podrían quedar contiguas y la landing mostraría
       * una banda doble sin separación.
       */
      const tone = index % 2 === 0 ? 'base' : 'muted';
      return (
        <Component
          data={content[section.key]}
          images={images}
          address={content.hero.address}
          tone={tone}
        />
      );
    })
  }
</LandingLayout>
