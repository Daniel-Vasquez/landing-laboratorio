{
  "name": "landing-laboratorio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "db:indexes": "node --env-file=.env scripts/ensure-indexes.ts",
    "db:seed": "node --env-file=.env scripts/seed.ts",
    "a11y:contrast": "node scripts/contrast-audit.mjs",
    "a11y:html": "node scripts/a11y-audit.mjs",
    "preflight": "node scripts/preflight.mjs",
    "db:seed-images": "node --env-file=.env scripts/seed-images.ts",
    "db:migrate-card-images": "node --env-file=.env scripts/migrate-card-images.ts",
    "check:icons": "node scripts/check-icon-catalog.ts",
    "budget": "node scripts/budget-check.mjs",
    "db:migrate-icons": "node --env-file=.env scripts/migrate-icons.ts",
    "dev:reset": "rm -rf node_modules/.vite node_modules/.vite-build .astro && astro dev",
    "db:seed-layout": "node --env-file=.env scripts/seed-section-layout.ts",
    "db:seed-lead-form": "node --env-file=.env scripts/seed-lead-form.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@hello-pangea/dnd": "^18.0.1",
    "@lucide/astro": "^1.48.0",
    "astro": "^7.3.5",
    "better-auth": "^1.7.6",
    "lucide-react": "^1.48.0",
    "mongodb": "^7.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
