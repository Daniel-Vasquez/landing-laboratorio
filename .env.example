# =============================================================================
#  Landing Laboratorio Clínico — Hospital Cristal
#  Plantilla de variables de entorno
# =============================================================================
#  USO:
#    cp .env.example .env     y rellena los valores marcados como <REQUERIDO>
#
#  REGLAS:
#    - LOS VALORES VAN SIN COMILLAS. Al copiarlos a Vercel, unas comillas
#      arrastradas hacen que el build falle con "Invalid URL" (Astro valida
#      `site`) o, peor, rompen las cookies de sesión en silencio.
#      El código las tolera y avisa en el log, pero no las pongas.
#    - Las URLs van SIN slash final. PUBLIC_SITE_URL y BETTER_AUTH_URL deben
#      coincidir EXACTAMENTE con el dominio servido.
#    - Solo las variables con prefijo PUBLIC_ llegan al navegador.
#      Cualquier otra queda del lado del servidor (build + funciones serverless).
#      NUNCA renombres una variable de abajo agregándole PUBLIC_.
#    - .env debe estar en .gitignore. Verifica con: git check-ignore -v .env
#    - Estas mismas variables deben cargarse en Vercel:
#      Project -> Settings -> Environment Variables
#      (ver tabla de scoping por entorno en planificacion.md, sección 10.1)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. BASE DE DATOS — MongoDB Atlas
# -----------------------------------------------------------------------------

# Cadena de conexión SRV del cluster.
# Atlas -> Database -> Connect -> Drivers -> Node.js
# Escapa con percent-encoding los caracteres especiales de la contraseña
# (@ -> %40, : -> %3A, / -> %2F, # -> %23).
# NO incluyas el nombre de la base en la ruta: se define en MONGODB_DB_NAME.
# Requiere Network Access 0.0.0.0/0 en Atlas (Vercel serverless no tiene IP fija).
# <REQUERIDO>
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=laboratorio

# Nombre de la base de datos. Usa una distinta por entorno para no mezclar
# contenido de producción con pruebas.
#   Production: laboratorio | Preview: laboratorio_preview | Local: laboratorio_dev
# <REQUERIDO>
MONGODB_DB_NAME=laboratorio


# -----------------------------------------------------------------------------
# 2. AUTENTICACIÓN — Better Auth
# -----------------------------------------------------------------------------

# Secreto para firmar cookies de sesión y tokens. Mínimo 32 bytes aleatorios.
# Genéralo con:   openssl rand -base64 32
# Cambiarlo invalida TODAS las sesiones activas.
# Debe ser idéntico en Production y Preview si quieres que el login funcione en ambos.
# <REQUERIDO>
BETTER_AUTH_SECRET=reemplaza-esto-con-openssl-rand-base64-32

# URL base absoluta donde corre la app. Better Auth la usa para construir
# callbacks y validar el origen de las peticiones.
# SIN slash final. Debe coincidir EXACTAMENTE con el dominio real (incluido https://),
# o las cookies de sesión serán rechazadas y el login entrará en bucle.
#   Local:      http://localhost:4321
#   Production: https://tu-subdominio.tu-dominio.com
# <REQUERIDO>
BETTER_AUTH_URL=http://localhost:4321


# -----------------------------------------------------------------------------
# 3. SITIO — expuesta al navegador
# -----------------------------------------------------------------------------

# URL pública canónica. Se usa en <link rel="canonical">, OpenGraph, sitemap.xml
# y robots.txt. SIN slash final. Normalmente idéntica a BETTER_AUTH_URL.
# ATENCIÓN: al llevar prefijo PUBLIC_, este valor SÍ termina en el HTML/JS servido.
# <REQUERIDO>
PUBLIC_SITE_URL=http://localhost:4321


# -----------------------------------------------------------------------------
# 4. REDESPLIEGUE AUTOMÁTICO — Vercel Deploy Hook
# -----------------------------------------------------------------------------

# URL del Deploy Hook que se dispara al guardar contenido en el dashboard.
# Crear en: Vercel -> Project -> Settings -> Git -> Deploy Hooks
#   Nombre: cms-content-update   |   Branch: main
#
# TRATAR COMO SECRETO: quien tenga esta URL puede disparar builds ilimitados
# y agotar tu cuota. Nunca la publiques ni le pongas prefijo PUBLIC_.
#
# DÉJALA VACÍA en desarrollo local y en el entorno Preview de Vercel:
#   - Local: evita disparar builds reales mientras programas.
#   - Preview: el hook apunta a `main`, así que un preview publicaría producción
#     desde otra rama. Bug silencioso y grave.
# Con el valor vacío, guardar contenido funciona con normalidad y el dashboard
# reporta el deploy como "disabled".
VERCEL_DEPLOY_HOOK_URL=

# Ventana de enfriamiento entre disparos del webhook, en segundos.
# Evita que editar varias secciones seguidas genere un build por cada guardado.
# Dentro de la ventana, los cambios se marcan como pendientes y se publican
# en el siguiente disparo elegible (o con el botón "Publicar ahora").
# Recomendado: 90. Rango sensato: 60–300.
DEPLOY_HOOK_COOLDOWN_SECONDS=90

# Secreto del cron que drena los cambios pendientes (opcional, ver planificacion.md 7.5).
# Vercel Cron lo envía automáticamente como: Authorization: Bearer <valor>
# Genéralo con:   openssl rand -hex 32
# Déjalo vacío si no implementas el cron de drenaje.
CRON_SECRET=


# -----------------------------------------------------------------------------
# 5. CONTROL DE ALTAS — seguridad del panel
# -----------------------------------------------------------------------------

# Habilita la ruta /registro y la creación de cuentas.
# Flujo recomendado: despliega con "true", crea las cuentas del equipo,
# cámbialo a "false" y redespliega. Cualquier valor distinto de "true" cierra el alta.
# En "false", /registro responde 404 y el POST directo devuelve 403.
ALLOW_PUBLIC_SIGNUP=true

# Código de invitación exigido en el formulario de registro.
# Si tiene valor, el alta pide un campo extra que debe coincidir (validado en servidor).
# Déjalo vacío para no exigirlo. Útil para mantener el registro abierto sin exponerlo.
SIGNUP_INVITE_CODE=


# -----------------------------------------------------------------------------
# 6. IMÁGENES — Cloudinary
# -----------------------------------------------------------------------------

# Nombre de la cuenta (Cloudinary -> Dashboard -> Product Environment).
# Aparece en las URLs de entrega, así que no es secreto, pero tampoco lleva
# prefijo PUBLIC_: el HTML ya sale renderizado con las URLs completas.
# <REQUERIDO>
CLOUDINARY_CLOUD_NAME=tu-cloud-name

# Credenciales de la Admin API (Settings -> API Keys).
# La subida se firma en el SERVIDOR. Una subida sin firmar desde el navegador
# expondría un upload preset abierto y permitiría a cualquiera llenar la cuenta.
# <REQUERIDO>
CLOUDINARY_API_KEY=000000000000000
# TRATAR COMO SECRETO: permite subir, transformar y BORRAR cualquier asset.
# <REQUERIDO>
CLOUDINARY_API_SECRET=reemplaza-esto-con-tu-api-secret

# Carpeta de destino. La cuenta usa carpetas dinámicas, así que este valor va en
# `asset_folder` al subir y NO forma parte del public_id.
# <REQUERIDO>
CLOUDINARY_FOLDER=landing-laboratorio


# -----------------------------------------------------------------------------
# 7. BUILD — tolerancia a fallos
# -----------------------------------------------------------------------------

# Si es "true" y MongoDB no está disponible o no está configurado, el build usa
# el contenido semilla (src/lib/content/seed.ts) en lugar de fallar.
# Permite `npm run build` sin credenciales y protege el deploy ante una caída de Atlas.
# En producción déjalo en "true": un build con semilla es preferible a no tener deploy,
# y el warning queda registrado en los logs de Vercel.
CONTENT_FALLBACK_TO_SEED=true


# =============================================================================
#  Variables inyectadas por Vercel — NO las declares aquí
#  VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_REGION,
#  VERCEL_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_REF
# =============================================================================
